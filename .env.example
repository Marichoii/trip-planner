# All variables below are PRIVATE server configuration. Never prefix with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_ENABLED=true
MOCHI_GROUP_ACCESS_HASH=
MOCHI_SESSION_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Exact origin, no trailing slash. Preview deployments need their own origin.
MOCHI_ALLOWED_ORIGINS=
# Only for localhost with vercel dev; ignored in VERCEL_ENV=production.
MOCHI_LOCAL_HTTP=false
